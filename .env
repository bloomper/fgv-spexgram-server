MYSQL_DATABASE=spexgram
MYSQL_ROOT_USER=root
MYSQL_USER=spexgram

API_KEYCLOAK_REALM=fgv
API_KEYCLOAK_CLIENT_CLIENT_ID=fgv-spexgram
API_IMPORT_SAMPLE_DATA=false
API_SAMPLE_DATA_SIZE=small
IMMICH_VERSION=v3.4.1
SPEXGRAM_WEB_ORIGIN=http://localhost:3004

# Where the API keeps its files (logs, media, imports, ...) when it runs in Docker Compose. Set it to
# ./data, the folder an API started from the IDE uses, when the API runs from the IDE and the other containers
# (e.g. the media server) should see its files.
#API_DATA=./.docker/api
